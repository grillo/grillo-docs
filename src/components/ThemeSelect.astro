---
import { Icon } from '@astrojs/starlight/components';
---

<grillo-theme-toggle>
  <button type="button" aria-label="Switch between dark and light theme">
    <Icon name="sun" class="sun" />
    <Icon name="moon" class="moon" />
  </button>
</grillo-theme-toggle>

<script>
  // Same storage key as Starlight's ThemeProvider, so the choice survives page loads without a flash.
  const storageKey = 'starlight-theme';

  class GrilloThemeToggle extends HTMLElement {
    constructor() {
      super();
      this.querySelector('button')?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem(storageKey, next);
        } catch {}
      });
    }
  }
  customElements.define('grillo-theme-toggle', GrilloThemeToggle);
</script>

<style>
  button {
    display: flex;
    padding: 0.375rem;
    border: 0;
    color: var(--sl-color-gray-2);
    background: transparent;
    cursor: pointer;
    font-size: 1.125rem;
  }
  button:hover {
    color: var(--sl-color-white);
  }
  :global([data-theme='dark']) .sun,
  :global([data-theme='light']) .moon {
    display: none;
  }
</style>
