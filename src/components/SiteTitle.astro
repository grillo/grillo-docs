---
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title">
  <img src="/img/grillo-logo-word-orange.svg" alt="Grillo" width="90" height="28" />
  <span class="word" translate="no">docs</span>
</a>

<style>
  .site-title {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    white-space: nowrap;
  }
  img {
    flex-shrink: 0;
    width: 84px;
    height: 26px;
  }
  .word {
    padding-left: 10px;
    border-left: 1px solid var(--sl-color-gray-4);
    color: var(--sl-color-gray-3);
    font: 400 16px/1 var(--grillo-font-display);
    letter-spacing: -0.02em;
  }
</style>
